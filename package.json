{
  "name": "emmal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --max-old-space-size=8192 node_modules/next/dist/bin/next dev",
    "build": "next build",
    "cf:build": "opennextjs-cloudflare build",
    "start": "next start",
    "lint": "next lint",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "optimize-images": "node scripts/optimize-images.mjs",
    "optimize-logos": "node scripts/optimize-images.mjs --dir=public/logos --maxWidth=400",
    "normalize-logos": "node scripts/normalize-logos.mjs",
    "optimize-videos": "node scripts/optimize-videos.mjs",
    "migrate:local": "wrangler d1 migrations apply emmal --local",
    "migrate:prod": "npx wrangler d1 migrations apply emmal --remote"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1067.0",
    "@aws-sdk/s3-request-presigner": "^3.1067.0",
    "@opennextjs/cloudflare": "^1.19.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "next": "16.2.3",
    "next-intl": "^4.11.0",
    "puppeteer": "^24.42.0",
    "react": "19.1.5",
    "react-dom": "19.1.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.39",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "eslint": "^9",
    "eslint-config-next": "15.4.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5.7.4",
    "wrangler": "^4.86.0"
  }
}
